# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── Gmail (required for sending) ─────────────────────────
# Your Gmail address (used as the sender)
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (NOT your normal password)
# Create one at: https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address to send the digest to (defaults to GMAIL_ADDRESS if not set)
TO_EMAIL=you@gmail.com

# ── Anthropic Claude API (recommended) ───────────────────
# Get key at: https://console.anthropic.com/
# If not set, rule-based fit-reason generation is used instead.
ANTHROPIC_API_KEY=sk-ant-...

# ── Adzuna (optional — adds global job coverage) ─────────
# Free tier: 250 req/month
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ── Crunchbase (optional — adds funding data) ─────────────
# Free basic API: https://data.crunchbase.com/docs
# If not set, falls back to best-effort public page scraping.
CRUNCHBASE_API_KEY=
